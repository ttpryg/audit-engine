{
    "name": "ttpryg/audit-engine",
    "description": "A framework-agnostic standalone audit logging engine library for PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "laravel/pint": "^1.20"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\AuditEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\AuditEngine\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "fix:check": "pint --test",
        "fix": "pint"
    }
}
